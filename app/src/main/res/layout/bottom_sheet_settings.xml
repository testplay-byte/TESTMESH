<?xml version="1.0" encoding="utf-8"?>
<!--
  Settings bottom sheet (v4).

  Design rules from user feedback (round 5):
  - Much rounder top corners on the sheet itself (rounded background + clip)
  - Modern Material switches (SwitchMaterial, bigger, proper Material styling)
  - Toggle rows are compact (single-line height, no dead vertical space)
  - "Swap Active Model" is a CENTERED button, only as wide as its text/icon;
    the current model name is NOT shown here (the top bar shows it)
  - Threshold sliders each get their OWN full-width row, stacked vertically
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_rounded"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="18dp"
    android:paddingBottom="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Settings"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="#1F2937"/>

    <!-- Centered swap-model button: hugs its content -->
    <TextView
        android:id="@+id/panelSelectModel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_model_swap"
        android:clickable="true"
        android:focusable="true"
        android:drawableStart="@drawable/ic_upload"
        android:drawablePadding="10dp"
        android:drawableTint="#BCF362"
        android:paddingHorizontal="22dp"
        android:paddingVertical="12dp"
        android:text="Swap Active Model"
        android:textColor="#FFFFFF"
        android:textSize="14sp"/>

    <!-- ── DISPLAY: two compact toggle rows ──────────────────────────────── -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DISPLAY"
        android:textColor="#64748B"
        android:textSize="10sp"
        android:textAllCaps="true"
        android:letterSpacing="0.2"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="4dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_btn"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Bounding Boxes"
            android:textColor="#FFFFFF"
            android:textSize="14sp"/>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchBoxes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_glass_btn"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Smooth Mesh Outline"
            android:textColor="#FFFFFF"
            android:textSize="14sp"/>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchSmooth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- ── HARDWARE: compact toggle row ──────────────────────────────────── -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HARDWARE"
        android:textColor="#64748B"
        android:textSize="10sp"
        android:textAllCaps="true"
        android:letterSpacing="0.2"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="4dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_btn"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="GPU Processing"
            android:textColor="#FFFFFF"
            android:textSize="14sp"/>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchGpu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- ── THRESHOLDS: each slider on its OWN full-width row ─────────────── -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="THRESHOLDS"
        android:textColor="#64748B"
        android:textSize="10sp"
        android:textAllCaps="true"
        android:letterSpacing="0.2"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="4dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_btn"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Minimum Confidence"
                android:textColor="#FFFFFF"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/tvConfValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_value_chip"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="35%"
                android:textColor="#0B0B0D"
                android:textSize="11sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderConf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="5"
            android:valueTo="95"
            android:stepSize="1"
            android:value="35"
            app:labelBehavior="gone"
            app:tickVisible="false"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_glass_btn"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="NMS Overlap (IoU)"
                android:textColor="#FFFFFF"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/tvIouValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_value_chip"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="45%"
                android:textColor="#0B0B0D"
                android:textSize="11sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderIou"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="10"
            android:valueTo="90"
            android:stepSize="1"
            android:value="45"
            app:labelBehavior="gone"
            app:tickVisible="false"/>
    </LinearLayout>

</LinearLayout>
