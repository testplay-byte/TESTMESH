<?xml version="1.0" encoding="utf-8"?>
<!--
  Settings bottom sheet (v5).

  Design rules from user feedback (round 6):
  - Swap Active Model: SOLID green (lime) button, centered, hugs content
  - iOS-style custom toggles (IOSToggle view), NOT material switches
  - Toggle rows: minimal height (just the content, no extra padding)
  - Threshold sliders: each on its own row, thicker track
  - Sheet background is fully rounded (drawn by bg_sheet_rounded; the dialog
    window backdrop is transparent so no square-corner ghosting)
-->
<!-- Root ScrollView so the taller sheet (MESH & OUTLINE section) always
     scrolls on small screens instead of clipping the last sliders. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_rounded"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="18dp"
    android:paddingBottom="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Settings"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="#1F2937"/>

    <!-- Centered solid-lime swap-model button -->
    <TextView
        android:id="@+id/panelSelectModel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_btn_lime_round"
        android:clickable="true"
        android:focusable="true"
        android:drawableStart="@drawable/ic_upload"
        android:drawablePadding="10dp"
        android:drawableTint="#0B0B0D"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        android:text="Swap Active Model"
        android:textColor="#0B0B0D"
        android:textSize="14sp"
        android:textStyle="bold"/>

    <!-- ── DISPLAY: two compact toggle rows ──────────────────────────────── -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DISPLAY"
        android:textColor="#64748B"
        android:textSize="10sp"
        android:textAllCaps="true"
        android:letterSpacing="0.2"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_btn"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Bounding Boxes"
            android:textColor="#FFFFFF"
            android:textSize="14sp"/>

        <com.example.aimeshvision.ui.IOSToggle
            android:id="@+id/toggleBoxes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_glass_btn"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Smooth Mesh Outline"
            android:textColor="#FFFFFF"
            android:textSize="14sp"/>

        <com.example.aimeshvision.ui.IOSToggle
            android:id="@+id/toggleSmooth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- Split & detect: tiled inference (SLOW, more detail) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_btn"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:layout_marginTop="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Split &amp; Detect (slow, more detail)"
            android:textColor="#FFFFFF"
            android:textSize="14sp"/>

        <com.example.aimeshvision.ui.IOSToggle
            android:id="@+id/toggleTile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- ── HARDWARE: compact toggle row ──────────────────────────────────── -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HARDWARE"
        android:textColor="#64748B"
        android:textSize="10sp"
        android:textAllCaps="true"
        android:letterSpacing="0.2"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_btn"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="GPU Processing"
            android:textColor="#FFFFFF"
            android:textSize="14sp"/>

        <com.example.aimeshvision.ui.IOSToggle
            android:id="@+id/toggleGpu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- ── THRESHOLDS: each slider on its OWN full-width row ─────────────── -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="THRESHOLDS"
        android:textColor="#64748B"
        android:textSize="10sp"
        android:textAllCaps="true"
        android:letterSpacing="0.2"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_btn"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Minimum Confidence"
                android:textColor="#FFFFFF"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/tvConfValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_value_chip"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="35%"
                android:textColor="#0B0B0D"
                android:textSize="11sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderConf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="5"
            android:valueTo="95"
            android:stepSize="1"
            android:value="35"
            app:labelBehavior="gone"
            app:tickVisible="false"
            app:trackHeight="8dp"
            app:thumbRadius="9dp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_glass_btn"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="NMS Overlap (IoU)"
                android:textColor="#FFFFFF"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/tvIouValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_value_chip"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="45%"
                android:textColor="#0B0B0D"
                android:textSize="11sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderIou"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="10"
            android:valueTo="90"
            android:stepSize="1"
            android:value="45"
            app:labelBehavior="gone"
            app:tickVisible="false"
            app:trackHeight="8dp"
            app:thumbRadius="9dp"/>
    </LinearLayout>

    <!-- ── MESH & OUTLINE: advanced geometry adjustments (round 19) ────────── -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MESH &amp; OUTLINE"
        android:textColor="#64748B"
        android:textSize="10sp"
        android:textAllCaps="true"
        android:letterSpacing="0.2"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"/>

    <!-- Mesh smoothness: blur passes applied to the mask before threshold
         (0 = crisp raw edge, 1 = default, 2 = max smoothing). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_btn"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Mesh Smoothness"
                android:textColor="#FFFFFF"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/tvSmoothValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_value_chip"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="1"
                android:textColor="#0B0B0D"
                android:textSize="11sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderSmooth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0"
            android:valueTo="2"
            android:stepSize="1"
            android:value="1"
            app:labelBehavior="gone"
            app:tickVisible="false"
            app:trackHeight="8dp"
            app:thumbRadius="9dp"/>
    </LinearLayout>

    <!-- Outline width: multiplier on the adaptive band width. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_glass_btn"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Outline Width"
                android:textColor="#FFFFFF"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/tvRingWidthValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_value_chip"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="100%"
                android:textColor="#0B0B0D"
                android:textSize="11sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderRingWidth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="50"
            android:valueTo="150"
            android:stepSize="1"
            android:value="100"
            app:labelBehavior="gone"
            app:tickVisible="false"
            app:trackHeight="8dp"
            app:thumbRadius="9dp"/>
    </LinearLayout>

    <!-- Outline opacity: band alpha on screen. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_glass_btn"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Outline Opacity"
                android:textColor="#FFFFFF"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/tvOutlineAlphaValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_value_chip"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="100%"
                android:textColor="#0B0B0D"
                android:textSize="11sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderOutlineAlpha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="25"
            android:valueTo="100"
            android:stepSize="1"
            android:value="100"
            app:labelBehavior="gone"
            app:tickVisible="false"
            app:trackHeight="8dp"
            app:thumbRadius="9dp"/>
    </LinearLayout>

    <!-- Mesh opacity: tint layer alpha on screen. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_glass_btn"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Mesh Opacity"
                android:textColor="#FFFFFF"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/tvMeshAlphaValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_value_chip"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="43%"
                android:textColor="#0B0B0D"
                android:textSize="11sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderMeshAlpha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="10"
            android:valueTo="100"
            android:stepSize="1"
            android:value="43"
            app:labelBehavior="gone"
            app:tickVisible="false"
            app:trackHeight="8dp"
            app:thumbRadius="9dp"/>
    </LinearLayout>

</LinearLayout>
</ScrollView>
