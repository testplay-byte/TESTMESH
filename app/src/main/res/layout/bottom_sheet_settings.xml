<?xml version="1.0" encoding="utf-8"?>
<!--
  Settings bottom sheet (v3 - compact redesign).

  Design rules from user feedback:
  - Title is just "Settings"
  - Tight vertical rhythm: everything fits on one screen
  - "Swap Active Model" is a distinct lime-outlined action row; the model
    name sits on the RIGHT of the row as a small chip, not underneath
  - GPU row: title only, no description line, Material toggle
  - Thresholds: two individual side-by-side cells, titles only
    ("Minimum Confidence" / "NMS Overlap (IoU)"), live value chips
  - No Diagnostics section (crash handling is automatic via the crash screen)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0F1420"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Settings"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="#1F2937"/>

    <!-- ── MODEL ─────────────────────────────────────────────────────────── -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MODEL"
        android:textColor="#64748B"
        android:textSize="10sp"
        android:textAllCaps="true"
        android:letterSpacing="0.2"
        android:layout_marginBottom="6dp"/>

    <!-- Distinct lime-outlined action row; current model name on the right -->
    <LinearLayout
        android:id="@+id/panelSelectModel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_model_swap"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_upload"
            app:tint="#BCF362"
            android:layout_marginEnd="12dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Swap Active Model"
            android:textColor="#FFFFFF"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/tvCurrentModelName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="110dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Bundled (default)"
            android:textColor="#BCF362"
            android:textSize="11sp"/>
    </LinearLayout>

    <!-- ── HARDWARE ──────────────────────────────────────────────────────── -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HARDWARE"
        android:textColor="#64748B"
        android:textSize="10sp"
        android:textAllCaps="true"
        android:letterSpacing="0.2"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="6dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_btn"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Enable GPU Processing"
            android:textColor="#FFFFFF"
            android:textSize="14sp"/>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchGpu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:thumbTint="#BCF362"
            android:trackTint="#243044"/>
    </LinearLayout>

    <!-- ── DISPLAY ───────────────────────────────────────────────────────── -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DISPLAY"
        android:textColor="#64748B"
        android:textSize="10sp"
        android:textAllCaps="true"
        android:letterSpacing="0.2"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="6dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_btn"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Bounding Boxes"
            android:textColor="#FFFFFF"
            android:textSize="14sp"/>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchBoxes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:thumbTint="#BCF362"
            android:trackTint="#243044"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_btn"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Smooth Mesh Outline"
            android:textColor="#FFFFFF"
            android:textSize="14sp"/>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchSmooth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:thumbTint="#BCF362"
            android:trackTint="#243044"/>
    </LinearLayout>

    <!-- ── THRESHOLDS: two individual cells side by side ─────────────────── -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="THRESHOLDS"
        android:textColor="#64748B"
        android:textSize="10sp"
        android:textAllCaps="true"
        android:letterSpacing="0.2"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="6dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:background="@drawable/bg_glass_btn"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Minimum Confidence"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/tvConfValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_value_chip"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="35%"
                    android:textColor="#0B0B0D"
                    android:textSize="11sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderConf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="5"
                android:valueTo="95"
                android:stepSize="1"
                android:value="35"
                app:labelBehavior="gone"
                app:thumbColor="#BCF362"
                app:trackColorActive="#BCF362"
                app:trackColorInactive="#243044"
                app:trackHeight="4dp"
                app:tickVisible="false"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_glass_btn"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="NMS Overlap"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/tvIouValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_value_chip"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="45%"
                    android:textColor="#0B0B0D"
                    android:textSize="11sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderIou"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="10"
                android:valueTo="90"
                android:stepSize="1"
                android:value="45"
                app:labelBehavior="gone"
                app:thumbColor="#BCF362"
                app:trackColorActive="#BCF362"
                app:trackColorInactive="#243044"
                app:trackHeight="4dp"
                app:tickVisible="false"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
