<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#111827"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ENGINE SETTINGS"
        android:textColor="#E5E7EB"
        android:textSize="18sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:layout_marginBottom="24dp"/>

    <!-- Model Selection Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MODEL CONFIGURATION"
        android:textColor="#94A3B8"
        android:textSize="10sp"
        android:textAllCaps="true"
        android:letterSpacing="0.2"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:id="@+id/panelSelectModel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_btn"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp"
        android:layout_marginBottom="20dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_tune"
            android:layout_marginEnd="16dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Swap Active Model"
                android:textColor="#FFFFFF"
                android:textSize="14sp"/>
            <TextView
                android:id="@+id/tvCurrentModelName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No model selected"
                android:textColor="#BCF362"
                android:textSize="12sp"/>
        </LinearLayout>
        
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_upload"
            android:alpha="0.5"/>
    </LinearLayout>

    <!-- GPU Toggle Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HARDWARE ACCELERATION"
        android:textColor="#94A3B8"
        android:textSize="10sp"
        android:textAllCaps="true"
        android:letterSpacing="0.2"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_btn"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_play_arrow"
            android:layout_marginEnd="16dp"
            android:rotation="-90"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enable GPU Processing"
                android:textColor="#FFFFFF"
                android:textSize="14sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Use NPU/GPU for inference"
                android:textColor="#94A3B8"
                android:textSize="12sp"/>
        </LinearLayout>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchGpu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            app:thumbTint="#BCF362"
            app:trackTint="#1F2937"
            xmlns:app="http://schemas.android.com/apk/res-auto"/>
    </LinearLayout>

    <!-- Inference Thresholds Section (F10: user-adjustable) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="INFERENCE THRESHOLDS"
        android:textColor="#94A3B8"
        android:textSize="10sp"
        android:textAllCaps="true"
        android:letterSpacing="0.2"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_btn"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="18dp"
        android:paddingBottom="14dp"
        android:layout_marginBottom="20dp">

        <!-- Confidence slider: Material slider with a value chip that shows
             the live percent inside the track end. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Confidence"
                android:textColor="#FFFFFF"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/tvConfValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_value_chip"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="35%"
                android:textColor="#0B0B0D"
                android:textSize="12sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderConf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:valueFrom="5"
            android:valueTo="95"
            android:stepSize="1"
            android:value="35"
            app:labelBehavior="gone"
            app:thumbColor="#BCF362"
            app:trackColorActive="#BCF362"
            app:trackColorInactive="#1F2937"
            app:trackHeight="6dp"
            app:tickVisible="false"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Minimum certainty to show a detection. Higher = fewer, cleaner boxes."
            android:textColor="#94A3B8"
            android:textSize="11sp"/>

        <!-- NMS IoU slider, same treatment -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="NMS Overlap (IoU)"
                android:textColor="#FFFFFF"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/tvIouValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_value_chip"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="45%"
                android:textColor="#0B0B0D"
                android:textSize="12sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderIou"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:valueFrom="10"
            android:valueTo="90"
            android:stepSize="1"
            android:value="45"
            app:labelBehavior="gone"
            app:thumbColor="#BCF362"
            app:trackColorActive="#BCF362"
            app:trackColorInactive="#1F2937"
            app:trackHeight="6dp"
            app:tickVisible="false"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="How much overlapping boxes may intersect before they merge. Higher = fewer duplicates."
            android:textColor="#94A3B8"
            android:textSize="11sp"/>
    </LinearLayout>

    <!-- Diagnostics Section: offline crash reports (filesDir/crash_logs) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DIAGNOSTICS"
        android:textColor="#94A3B8"
        android:textSize="10sp"
        android:textAllCaps="true"
        android:letterSpacing="0.2"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:id="@+id/panelCrashLogs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_btn"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_tune"
            android:layout_marginEnd="16dp"
            android:alpha="0.7"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Crash Reports"
                android:textColor="#FFFFFF"
                android:textSize="14sp"/>
            <TextView
                android:id="@+id/tvCrashCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 saved on this device"
                android:textColor="#94A3B8"
                android:textSize="12sp"/>
        </LinearLayout>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_upload"
            android:alpha="0.5"/>
    </LinearLayout>

</LinearLayout>
