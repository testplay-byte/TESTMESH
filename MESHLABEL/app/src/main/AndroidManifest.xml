<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- MeshLabel needs NO permissions:
         - images come from the system photo picker (PickVisualMedia),
         - the MediaPipe model is bundled in assets (no network),
         - all output is written to app-private storage. -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MeshLabel"
        tools:targetApi="31">

        <!-- Library (launcher): list of saved image+JSON annotation pairs. -->
        <activity
            android:name=".LibraryActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MeshLabel"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Editor: canvas + polygon tools + Magic Touch segmentation.
             Portrait-locked so annotation coordinates survive rotation
             without a full state-restore pipeline (documented trade-off). -->
        <activity
            android:name=".EditorActivity"
            android:exported="false"
            android:theme="@style/Theme.MeshLabel"
            android:screenOrientation="portrait" />

    </application>

</manifest>
