<?xml version="1.0" encoding="utf-8"?>
<!-- Library screen: saved image+JSON pairs (LabelMe's folder convention). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="MeshLabel"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/btnExport"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_btn"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:text="Export YOLO"
            android:textColor="#00E676"
            android:textSize="13sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="20dp"
        android:background="#1F2937"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/projectList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <TextView
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="72dp"
                android:text="No annotations yet.\n\nAdd an image to create your first LabelMe project."
                android:textColor="#64748B"
                android:textSize="15sp"/>
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/btnAddImage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginVertical="14dp"
        android:background="@drawable/bg_btn_lime_round"
        android:gravity="center"
        android:paddingVertical="14dp"
        android:text="＋  Add Image"
        android:textColor="#0B0B0D"
        android:textSize="15sp"
        android:textStyle="bold"/>
</LinearLayout>
